# =============================================================================
# Sightline — Caddyfile (reverse proxy with automatic TLS)
# =============================================================================
# Routes:
#   /proposal*, /api/proposals*, /api/calls*, /api/proposal-v2*  → proposal:5002
#   Everything else                                                   → sightline:5001

sightlinehumanitarian.com, www.sightlinehumanitarian.com {
    encode zstd gzip

    # ── Security headers ──────────────────────────────────────────────────
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # ── Proposal Studio: static assets ────────────────────────────────────
    # Short cache: JS/CSS change on every deploy; 5 min TTL prevents stale UI
    @proposal_static path /proposal/static/*
    handle @proposal_static {
        header Cache-Control "public, max-age=300"
        reverse_proxy proposal:5002 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Proposal Studio: SPA entry points ─────────────────────────────────
    @proposal_spa path /proposal /proposal/
    handle @proposal_spa {
        reverse_proxy proposal:5002 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Proposal Studio: API endpoints ────────────────────────────────────
    @proposal_api path /api/proposals* /api/calls* /api/proposal-v2* /api/auth/me
    handle @proposal_api {
        reverse_proxy proposal:5002 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Proposal Studio: health check ─────────────────────────────────────
    @proposal_health path /proposal/health
    handle @proposal_health {
        reverse_proxy proposal:5002 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Sightline: SSE endpoints — no buffering ───────────────────────────
    @sse {
        path /api/agent/chat /api/sitrep/stream/*
    }
    handle @sse {
        reverse_proxy sightline:5001 {
            flush_interval -1
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    # ── Sightline: Upload endpoint — larger body ──────────────────────────
    @upload {
        path /api/ingest/upload
    }
    handle @upload {
        request_body {
            max_size 50MB
        }
        reverse_proxy sightline:5001
    }

    # ── Sightline: static assets ──────────────────────────────────────────
    # Short cache (5 min): app.js/auth.js are esbuild-bundled per deploy
    @sightline_static {
        path /static/*
    }
    handle @sightline_static {
        header Cache-Control "public, max-age=300"
        reverse_proxy sightline:5001
    }

    # ── Everything else → Sightline ───────────────────────────────────────
    handle {
        reverse_proxy sightline:5001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Access log ────────────────────────────────────────────────────────
    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# Local dev (HTTP only — no TLS)
:80 {
    encode zstd gzip

    @proposal_static path /proposal/static/*
    handle @proposal_static {
        header Cache-Control "public, max-age=300"
        reverse_proxy proposal:5002
    }

    @proposal_spa path /proposal /proposal/
    handle @proposal_spa {
        reverse_proxy proposal:5002
    }

    @proposal_api path /api/proposals* /api/calls* /api/proposal-v2* /api/auth/me
    handle @proposal_api {
        reverse_proxy proposal:5002
    }

    @proposal_health path /proposal/health
    handle @proposal_health {
        reverse_proxy proposal:5002
    }

    @static_assets {
        path /static/*
    }
    handle @static_assets {
        header Cache-Control "public, max-age=604800"
        reverse_proxy sightline:5001
    }

    handle {
        reverse_proxy sightline:5001
    }
}