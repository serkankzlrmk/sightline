# =============================================================================
# Sightline — Caddyfile (reverse proxy with automatic TLS)
# =============================================================================

# Production domain — Caddy gets TLS certs automatically
sightlinehumanitarian.com, www.sightlinehumanitarian.com {
    encode zstd gzip

    @static_assets {
        path /static/*
    }
    header @static_assets Cache-Control "public, max-age=604800"

    # Security headers
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # SSE endpoints — no buffering
    @sse {
        path /api/agent/chat /api/sitrep/stream/*
    }
    handle @sse {
        reverse_proxy app:5001 {
            flush_interval -1
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    # Upload endpoint — larger body
    @upload {
        path /api/ingest/upload
    }
    handle @upload {
        request_body {
            max_size 50MB
        }
        reverse_proxy app:5001
    }

    # Everything else
    handle {
        reverse_proxy app:5001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Access log
    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# Local dev (HTTP only — no TLS)
:80 {
    encode zstd gzip
    @static_assets {
        path /static/*
    }
    header @static_assets Cache-Control "public, max-age=604800"
    reverse_proxy app:5001
}
