[Unit]
Description=NovaSphere Data Platform
After=network.target

[Service]
Type=simple
User=novasphere
Group=novasphere
WorkingDirectory=/opt/novasphere/current
Environment="PATH=/opt/novasphere/current/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONPATH=/opt/novasphere/current"
ExecStart=/opt/novasphere/current/venv/bin/gunicorn -c deploy/gunicorn.conf.py server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/novasphere/current /opt/novasphere/data /opt/novasphere/releases /var/log/novasphere
ProtectHome=true

[Install]
WantedBy=multi-user.target