[Unit]
Description=ReliefAgent Data Platform
After=network.target

[Service]
Type=simple
User=reliefagent
Group=reliefagent
WorkingDirectory=/opt/reliefagent/current
Environment=DOTENV_PATH=/opt/reliefagent/data/.env
Environment=PATH=/opt/reliefagent/current/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/reliefagent/current/venv/bin/gunicorn -c /opt/reliefagent/current/deploy/gunicorn.conf.py server:app
Restart=always
RestartSec=5
SyslogIdentifier=reliefagent
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/reliefagent/data /opt/reliefagent/releases /var/log/reliefagent /var/log/sightline /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target