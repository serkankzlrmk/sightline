[Unit]
Description=ReliefAgent Data Platform
After=network.target

[Service]
Type=simple
User=reliefagent
Group=reliefagent
WorkingDirectory=/opt/reliefagent
Environment="PATH=/opt/reliefagent/venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/opt/reliefagent/venv/bin/gunicorn -c deploy/gunicorn.conf.py server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/reliefagent/reliefweb_downloads /opt/reliefagent/output /opt/reliefagent/reliefweb_chroma /var/log/reliefagent
ProtectHome=true

[Install]
WantedBy=multi-user.target