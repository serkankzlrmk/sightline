[Unit]
Description=ReliefAgent Data Platform
After=network.target

[Service]
Type=simple
User=reliefagent
Group=reliefagent
WorkingDirectory=/opt/reliefagent/current
Environment="PATH=/opt/reliefagent/current/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONPATH=/opt/reliefagent/current"
ExecStart=/opt/reliefagent/current/venv/bin/gunicorn -c deploy/gunicorn.conf.py server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/reliefagent/current /opt/reliefagent/data /opt/reliefagent/releases /var/log/reliefagent
ProtectHome=true

[Install]
WantedBy=multi-user.target