# ====================================
# Sightline — .env.example
# Copy this file to .env and fill in values.
# NEVER commit your .env to version control.
# ====================================

# ================================
# Firebase Configuration
# ================================
# Frontend web app config (used by Firebase JS SDK in auth.js)
# These are public-facing values safe to expose in client-side JS.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin UIDs (comma-separated Firebase UIDs with SITREP/Ingest access)
# Find your UID in Firebase Console → Authentication → Users
ADMIN_UIDS=

# ================================
# Server / Auth Modes
# ================================
# DESKTOP_MODE: bypass Firebase auth for local desktop use (loopback only).
# When true, all requests get a mock admin user — no Firebase needed.
# Combine with SERVER_HOST=127.0.0.1 for safety.
DESKTOP_MODE=false

# Public contact email shown in the frontend (rate-limit messages, etc.)
CONTACT_EMAIL=support@sightline.ai

# Firebase service account JSON path (optional — falls back to well-known locations)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Google Search Console read-only reporting. Grant the service-account email
# access to the exact property configured in GSC_SITE_URL.
GSC_ENABLED=false
GSC_SITE_URL=https://sightlinehumanitarian.com/
GSC_CREDENTIALS_PATH=
GSC_DB_PATH=
GSC_LOOKBACK_DAYS=28
GSC_DATA_LAG_DAYS=3
GSC_ROW_LIMIT=1000

# ================================
# Paths
# ================================
DOWNLOADS_DIR=reliefweb_downloads
DB_PATH=reliefweb.db
CHATS_DB_PATH=chats.db
CHROMA_DIR=reliefweb_chroma
CHROMA_COLLECTION=reliefweb_chunks

# ================================
# Observability (LLM/RAG telemetry)
# ================================
# Separate SQLite DB for per-turn telemetry (turns, tool_calls, feedback).
# Defaults to obs.db next to CHATS_DB_PATH. Set OBS_ENABLED=false to disable.
OBS_DB_PATH=
OBS_ENABLED=true
OBS_RETENTION_DAYS=90

# ================================
# Error monitoring (errors.db)
# ================================
ERRORS_DB_PATH=
ERRORS_ENABLED=true
ERRORS_RETENTION_DAYS=90
# Salt for hashing user ids in error records (set a long random value in prod)
ERRORS_SALT=
RELEASE_SHA=dev

# ================================
# Alerts (scripts/alert_check.py, cron every 5 min)
# ================================
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_5XX_RATE=0.02
ALERT_TOOL_ERROR_RATE=0.10
ALERT_MIN_REQUESTS=20
ALERT_COOLDOWN_MIN=30
ALERT_DAILY_COST_USD=25
ALERT_USER_DAILY_COST_USD=5

# Tool resilience (retry transient upstream failures + circuit breaker)
TOOL_RETRY_ATTEMPTS=2
TOOL_CIRCUIT_THRESHOLD=3
TOOL_CIRCUIT_COOLDOWN_SECONDS=60

# Max concurrent chat SSE streams (gunicorn has 4 threads by default)
CHAT_MAX_CONCURRENT=8

# ================================
# Vector Store
# ================================
# ChromaDB is the live vector store. Supabase/pgvector is not used.
# Embedding dimension (384 for all-MiniLM-L6-v2)
EMBEDDING_DIM=384

# ================================
# LLM Provider
# ================================
# Options: "openrouter" (recommended for production) or "ollama" (local)
LLM_PROVIDER=openrouter

# --- OpenRouter (recommended for production) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Ollama (OpenAI-compatible API, for local dev) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=60

# --- Model Aliases ---
# OpenRouter models: https://openrouter.ai/models
# Examples: google/gemma-4-31b-it, meta-llama/llama-3-70b-instruct
ACTIVE_MODEL=google/gemma-4-31b-it
LLM_MODEL=google/gemma-4-31b-it

# --- Model Parameters ---
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=2048

# --- Pipeline LLM Settings ---
LLM_TIMEOUT=900
LLM_MAX_RETRIES=3
LLM_MODEL_QUESTIONS=google/gemma-4-31b-it
LLM_TEMPERATURE_QUESTIONS=0.7
LLM_MODEL_FILTER=google/gemma-4-31b-it
LLM_TEMPERATURE_FILTER=0.0
LLM_MODEL_ANSWERS=google/gemma-4-31b-it
LLM_TEMPERATURE_ANSWERS=0.0

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RETRIEVAL_TOP_K_SUMMARY=20
RRF_K=60
RRF_NUM_SUBQUERIES=4

# --- Clustering ---
HP_SEARCH_ITERATIONS=30
HP_MIN_CLUSTERS=4

# --- Question Generation ---
QUESTION_RUNS_PER_CLUSTER=3
QUESTION_DEDUP_THRESHOLD=0.7
MAX_QUESTIONS_PER_CLUSTER=6

# ================================
# ReliefWeb API
# ================================
RELIEFWEB_APPNAME=your_app_name_here

# ================================
# HDX (Humanitarian Data Exchange)
# ================================
# Get your app identifier from: https://hapi.humdata.org/docs#/Generate%20App%20Identifier
# Format: base64("app_name:email")
# Example: base64("hdx-mcp-agent:user@example.com")
HDX_APP_IDENTIFIER=
HDX_BASE_URL=https://hapi.humdata.org/api/v2
HDX_TIMEOUT=30.0
HDX_RATE_LIMIT_REQUESTS=10
HDX_RATE_LIMIT_PERIOD=60.0

# ================================
# News API (NewsAPI.org — World News)
# ================================
# Get your API key from: https://newsapi.org/register
# Free tier: 100 requests/day
NEWS_API_KEY=
NEWS_BASE_URL=https://newsapi.org/v2
NEWS_TIMEOUT=15.0
NEWS_RATE_LIMIT_REQUESTS=80
NEWS_RATE_LIMIT_PERIOD=86400.0
NEWS_CACHE_TTL=3600

# ================================
# Optional humanitarian data sources
# ================================
# ACLED — conflict events (email+password OR API key)
ACLED_EMAIL=
ACLED_PASSWORD=
ACLED_API_KEY=
# UNHCR — refugee statistics (API key required)
UNHCR_API_KEY=
# NASA FIRMS — active fires (MAP KEY required)
FIRMS_MAP_KEY=
# FAO GIEWS — food prices/crops (schema pending; keep disabled for now)
GIEWS_ENABLED=false
# OSM/Overpass is keyless; optional custom mirror
OVERPASS_BASE_URL=

# ================================
# MCP servers (optional)
# ================================
MCP_ARXIV_ENABLED=true
MCP_SEQUENTIAL_THINKING_ENABLED=true
MCP_BRAVE_ENABLED=false
BRAVE_API_KEY=
BRAVE_DAILY_LIMIT=30
MCP_TAVILY_ENABLED=false
TAVILY_API_KEY=

# ================================
# Server
# ================================
SERVER_HOST=0.0.0.0
SERVER_PORT=5001
SERVER_DEBUG=false
SERVER_API_KEY=
# IMPORTANT: Change CORS_ORIGINS to your production domain in production!
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Optional Cloudflare R2 backups. Live reads/writes never use R2.
R2_BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_BACKUP_PREFIX=sightline-backups
R2_BACKUP_RETENTION_DAYS=30

# Secret key for Flask sessions (auto-generated if empty)
SECRET_KEY=

# ================================
# Analytics (Google Analytics 4)
# ================================
# GA4 Measurement ID — injects the gtag.js tag into the landing page, the SPA
# (/app) and all SEO pages (/bulletins, /countries, /sitrep/*, /map).
# Leave empty to disable analytics entirely (local/dev default).
GOOGLE_ANALYTICS_ID=G-SJMDY64ZKG

# Google AdSense publisher ID (ca-pub-XXXXXXXX). Empty = no ad code rendered.
# Ads appear ONLY on public SSR pages (crisis/bulletin/sitrep/country) and are
# hidden for signed-in users; the SPA itself never shows ads.
GOOGLE_ADSENSE_CLIENT=
GOOGLE_ADSENSE_SLOT_ID=
# Keep false until a Google-certified CMP is configured and verified for the site.
GOOGLE_ADSENSE_CMP_READY=false

# CARTO basemap API key for the crisis map (https://carto.com/basemaps/apikey/).
# CARTO raster basemaps require a key since Aug 2026; keyless tiles render an
# "API key required" watermark. The key is free (5M tile requests/month).
# Empty = the crisis map uses OpenStreetMap tiles directly (no key needed).
CARTO_API_KEY=

# Operational freshness. Ingestion status is stored beside the primary database.
INGEST_STATUS_PATH=
DATA_FRESHNESS_MAX_AGE_DAYS=3

# ================================
# SSL Verification
# ================================
# Set to "false" ONLY for development behind a corporate proxy.
SSL_VERIFY=true
# Optional: path to a CA bundle file for corporate proxies
SSL_CA_BUNDLE=

# ================================
# Rate Limiting
# ================================
DAILY_MESSAGE_LIMIT=3

# ================================
# Logging
# ================================
LOG_LEVEL=INFO
